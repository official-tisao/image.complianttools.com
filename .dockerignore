# Keep the build context tiny. nginx:alpine + the static build is what
# actually ships; nothing in here should reach the daemon.

# Version control
.git
.gitattributes
.github
.gitignore

# Dependencies and build outputs (we build inside the container)
**/node_modules
**/.svelte-kit
**/dist
**/coverage
**/.turbo
.cache
apps/web/build

# OCR language/script/helper files are fetched directly by the browser from the
# pinned upstream CDN and cached by the browser. Exclude local caches, retaining
# only the CDN-blocked model required for Cyrillic OCR.
apps/web/static/tessdata/*.traineddata
apps/web/static/tessdata/script/*.traineddata
!apps/web/static/tessdata/script/Cyrillic.traineddata

# Editor / OS noise
**/.vscode
**/.idea
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.tmp

# Test / scratch / docs not needed at runtime
**/test
**/tests
**/__tests__
**/*.test.ts
**/*.test.mjs
**/*.spec.ts
**/*.spec.mjs
**/fixtures
**/bench
**/.generated

# Local environment
.env
.env.*
!.env.example
docker-compose.override.yml

# This file itself
Dockerfile
docker-compose.yml
docker-compose.yaml
.dockerignore

# Logs
**/*.log
**/npm-debug.log*
**/pnpm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
