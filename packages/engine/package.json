{
  "name": "@complianttools/image-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ops/raster": {
      "types": "./dist/ops/raster.d.ts",
      "default": "./dist/ops/raster.js"
    },
    "./codecs/encode": {
      "types": "./dist/codecs/encode.d.ts",
      "default": "./dist/codecs/encode.js"
    },
    "./codecs/avif-encode": {
      "types": "./dist/codecs/third-party/avif-encode.d.ts",
      "default": "./dist/codecs/third-party/avif-encode.js"
    },
    "./codecs/jxl-encode": {
      "types": "./dist/codecs/third-party/jxl-encode.d.ts",
      "default": "./dist/codecs/third-party/jxl-encode.js"
    },
    "./pipeline/execute": {
      "types": "./dist/pipeline/execute.d.ts",
      "default": "./dist/pipeline/execute.js"
    },
    "./pipeline/target-size": {
      "types": "./dist/pipeline/target-size.d.ts",
      "default": "./dist/pipeline/target-size.js"
    },
    "./schemas/options": {
      "types": "./dist/schemas/options.d.ts",
      "default": "./dist/schemas/options.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench": "node bench/run.mjs",
    "test": "node test/all.test.mjs && vitest run test --exclude test/**/*.test.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/jxl": "1.3.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@resvg/resvg-wasm": "2.6.2",
    "ag-psd": "31.0.2",
    "dxf-parser": "1.1.2",
    "fflate": "0.8.3",
    "gifuct-js": "2.1.2",
    "imagetracerjs": "1.2.6",
    "mediabunny": "1.25.1",
    "mp4box": "2.4.1",
    "parse-exr": "1.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "utif": "3.1.0",
    "zod": "4.4.3"
  }
}
