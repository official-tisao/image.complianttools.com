    "./codecs/jxl-encode": {
      "types": "./dist/codecs/third-party/jxl-encode.d.ts",
      "default": "./dist/codecs/third-party/jxl-encode.js"
    },
    "./pipeline/execute": {
      "types": "./dist/pipeline/execute.d.ts",
      "default": "./dist/pipeline/execute.js"
    },
    "./pipeline/target-size": {
      "types": "./dist/pipeline/target-size.d.ts",
      "default": "./dist/pipeline/target-size.js"
    },
    "./documents/pdf": {
      "types": "./dist/documents/pdf.d.ts",
      "default": "./dist/documents/pdf.js"
    },
    "./documents/pdf-read": {
      "types": "./dist/documents/pdf-read.d.ts",
      "default": "./dist/documents/pdf-read.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./export/embedded": {
      "types": "./dist/export/embedded.d.ts",
      "default": "./dist/export/embedded.js"
    },
    "./metadata/container": {
      "types": "./dist/metadata/container.d.ts",
      "default": "./dist/metadata/container.js"
    },
    "./schemas/options": {
      "types": "./dist/schemas/options.d.ts",
      "default": "./dist/schemas/options.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./layer": {
      "types": "./dist/layer/model.d.ts",
      "default": "./dist/layer/model.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench": "node bench/run.mjs",
    "bench:operations": "node bench/operations.mjs",
    "test": "node test/all.test.mjs && vitest run test --exclude \"**/*.test.mjs\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "typescript": "catalog:",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/jxl": "1.3.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@resvg/resvg-wasm": "2.6.2",
    "ag-psd": "31.0.2",
    "dxf-parser": "1.1.2",
    "fflate": "0.8.3",
    "gifuct-js": "2.1.2",
    "imagetracerjs": "1.2.6",
    "mediabunny": "1.25.1",
    "mp4box": "2.4.1",
    "onnxruntime-web": "1.30.0",
    "parse-exr": "1.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "tesseract.js": "7.0.0",
    "utif": "3.1.0",
    "zod": "4.4.3"
  }
}
