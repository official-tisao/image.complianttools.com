{
  "name": "@complianttools/image-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ops/raster": {
      "types": "./dist/ops/raster.d.ts",
      "default": "./dist/ops/raster.js"
    },
    "./ops/smart-crop": {
      "types": "./dist/ops/smart-crop.d.ts",
      "default": "./dist/ops/smart-crop.js"
    },
    "./codecs/encode": {
      "types": "./dist/codecs/encode.d.ts",
      "default": "./dist/codecs/encode.js"
    },
    "./codecs/gif": {
      "types": "./dist/codecs/third-party/gif.d.ts",
      "default": "./dist/codecs/third-party/gif.js"
    },
    "./codecs/apng": {
      "types": "./dist/codecs/simple/apng.d.ts",
      "default": "./dist/codecs/simple/apng.js"
    },
    "./codecs/animated-webp": {
      "types": "./dist/codecs/simple/animated-webp.d.ts",
      "default": "./dist/codecs/simple/animated-webp.js"
    },
    "./codecs/animation-video": {
      "types": "./dist/codecs/platform/animation-video.d.ts",
