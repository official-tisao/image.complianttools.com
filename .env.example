# Local container runtime. Copy to `.env` and adjust as needed.

# Host port to publish. Container always listens on 80.
HOST_PORT=8080

# Image tag — `local` is what `docker compose build` produces by default.
TAG=local

# Public URL the app is served from (used for any links it generates).
PUBLIC_URL=http://localhost:8080

# nginx log level: debug | info | notice | warn | error | crit.
LOG_LEVEL=warn

# Container timezone.
TZ=UTC

# Optional T32 Real-ESRGAN browser model sources. These are read only by the
# container's startup config writer; model files are never fetched or bundled
# by the Docker build or container. Set each primary to an immutable HTTPS URL
# from the pinned public Hugging Face commit. A fallback is tried only
# when the primary returns 403 or fails because of network/CORS. Both sources
# must serve the exact registered bytes and SHA-256 before a browser can cache
# or run the model. Leave a fallback blank to disable it.
T32_ESRGAN_X2_URL=https://huggingface.co/fernandotonon/QtMeshEditor-models/resolve/d14119a40dfeef208e4e724dfaceb2640d2df95b/RealESRGAN_x2plus.onnx
T32_ESRGAN_X2_FALLBACK_URL=
T32_ESRGAN_X4_URL=https://huggingface.co/fernandotonon/QtMeshEditor-models/resolve/d14119a40dfeef208e4e724dfaceb2640d2df95b/RealESRGAN_x4plus.onnx
T32_ESRGAN_X4_FALLBACK_URL=
