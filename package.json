{
  "name": "image-complianttools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9 <10"
  },
  "pnpm": {
    "overrides": {
      "argparse@2.0.1": "1.0.10"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm verify:attributions && tsx scripts/fetch-wasm.ts --verify && turbo build && pnpm verify:route-budgets && pnpm size",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:no-network": "playwright test e2e/no-network.spec.ts",
    "test:ui-visual": "playwright test e2e/ui-visual.spec.ts",
    "test:credential-leak": "pnpm --filter @complianttools/image-engine build && node packages/engine/test/credential-leak.test.mjs",
    "lint": "eslint . && turbo lint && pnpm lint:fixtures",
    "lint:fixtures": "node scripts/verify-lint-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && turbo typecheck",
    "commitlint": "node scripts/commitlint.mjs",
    "verify:licenses": "tsx scripts/verify-licenses.ts",
    "verify:licenses:write": "tsx scripts/verify-licenses.ts --write",
    "verify:attributions": "tsx scripts/verify-attributions.ts",
    "verify:assets": "tsx scripts/verify-static-assets.ts",
    "verify:headers": "tsx scripts/verify-headers.ts",
    "verify:trademarks": "tsx scripts/verify-trademarks.ts",
    "verify:wasm": "tsx scripts/fetch-wasm.ts --verify",
    "verify:plan-sync": "tsx scripts/check-plan-sync.ts",
    "verify:route-budgets": "tsx scripts/verify-route-budgets.ts",
    "verify:raw-corpus": "pnpm --filter @complianttools/image-engine build && node scripts/verify-raw-corpus.mjs",
    "size": "size-limit",
    "lighthouse": "lhci autorun",
    "wasm:fetch": "tsx scripts/fetch-wasm.ts",
    "test:gates": "tsx scripts/test-static-assets.ts && tsx scripts/test-license-gate.ts && tsx scripts/test-attribution-gate.ts && tsx scripts/test-trademark-gate.ts && tsx scripts/test-wasm-gate.ts && tsx scripts/test-plan-sync.ts",
    "progress": "node scripts/plan-progress.mjs",
    "prepare": "lefthook install"
  },
  "size-limit": [
    {
      "name": "tool /convert",
      "path": "apps/web/build/convert.html",
      "limit": "90 kB"
    },
    {
      "name": "format-pair",
      "path": "apps/web/build/convert/png-to-webp.html",
      "limit": "90 kB"
    },
    {
      "name": "reference",
      "path": "apps/web/build/docs/formats/jpeg.html",
      "limit": "20 kB"
    },
    {
      "name": "connect-ai",
      "path": "apps/web/build/connect-ai.html",
      "limit": "45 kB"
    },
    {
      "name": "app-shell",
      "path": "apps/web/build/editor.html",
      "limit": "220 kB"
    }
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/lint": "21.2.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.22.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "size-limit": "13.0.3",
    "svelte-eslint-parser": "1.8.0",
    "tsx": "4.23.11",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.20.0"
  }
}
