# Project environment reference
#
# Copy the values you need into a local `.env` file (or export them in your
# shell). Blank values are intentional: they enable an optional integration
# only when you provide a path or URL. Never commit credentials or production
# secrets. The root docker-compose.yml consumes the container settings below;
# the Keycloak values are for the separate deploy/keycloak-local stack.

# -----------------------------------------------------------------------------
# Static web container (docker compose up)
# -----------------------------------------------------------------------------
HOST_PORT=8080
TAG=local
PUBLIC_URL=http://localhost:8080
LOG_LEVEL=warn
TZ=UTC

# T32 Tier 2 Real-ESRGAN browser model sources. The browser downloads these
# URLs on demand; model bytes are not copied into the image. Keep URLs pinned
# to immutable revisions and provide a fallback only when you control an
# alternate origin serving the same registered bytes.
T32_ESRGAN_X2_URL=https://huggingface.co/fernandotonon/QtMeshEditor-models/resolve/d14119a40dfeef208e4e724dfaceb2640d2df95b/RealESRGAN_x2plus.onnx
T32_ESRGAN_X2_FALLBACK_URL=
T32_ESRGAN_X4_URL=https://huggingface.co/fernandotonon/QtMeshEditor-models/resolve/d14119a40dfeef208e4e724dfaceb2640d2df95b/RealESRGAN_x4plus.onnx
T32_ESRGAN_X4_FALLBACK_URL=

# T57 YuNet face detector source. This is also downloaded by the browser only
# when automatic detection is requested; manual blur remains available.
T57_YUNET_MODEL_URL=https://media.githubusercontent.com/media/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_detection_yunet/face_detection_yunet_2023mar.onnx

# Override only for a custom image layout or read-only web root.
T32_RUNTIME_CONFIG_PATH=/usr/share/nginx/html/t32-runtime-config.json

# -----------------------------------------------------------------------------
# Local GitHub Actions-compatible runner (docker compose --profile githubci)
# -----------------------------------------------------------------------------
GITHUBCI_IMAGE=ctimg-githubci:local
GITHUBCI_PARALLEL=2
GITHUBCI_MEMORY=3g
GITHUBCI_CPUS=2
GITHUBCI_BASE=HEAD^

# -----------------------------------------------------------------------------
# Local development and Playwright
# -----------------------------------------------------------------------------
# apps/web/dev-server.mjs listens on PORT. Playwright uses PLAYWRIGHT_PORT.
PORT=4173
PLAYWRIGHT_PORT=4173
# Set to 1 for focused tests that should not prefetch English and OSD OCR data.
PLAYWRIGHT_SKIP_OCR_TESSDATA_PREFETCH=0

# Optional local paths and benchmark controls.
P4_MODEL_CACHE_DIR=
GIFSICLE_PATH=
T57_BASE_URL=http://127.0.0.1:4173
BENCH_RUNNER_ID=
BENCH_RECORD=0
CT_LICENSE_REPORT=

# -----------------------------------------------------------------------------
# CI-only values (normally supplied by GitHub Actions or the local runner)
# -----------------------------------------------------------------------------
# These are listed so the complete environment surface is discoverable. Leave
# them empty for normal local development.
CI=
GITHUB_EVENT_PATH=
GITHUB_OUTPUT=
GITHUB_STEP_SUMMARY=
PLAN_SYNC_CHANGED_FILES=
PLAN_SYNC_COMMIT_BODY=
GITHUBCI_RUN_ID=

# -----------------------------------------------------------------------------
# Optional local Keycloak stack (deploy/keycloak-local/docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
